# Server-only. When set, contact/audit requests are POSTed as JSON to this URL
# (e.g. a Slack/Zapier/n8n/Formspree-style webhook or your own endpoint).
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the X-Sayable-Signature header to the webhook.
CONTACT_WEBHOOK_SECRET=
# Public. The business inbox shown on the site and used for mailto fallbacks.
NEXT_PUBLIC_CONTACT_EMAIL=
